{
  "name": "team-approval-checker",
  "description": "Team Approval Checker",
  "version": "2.0.0",
  "author": "hayawata3626",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/hayawata3626/team-approval-checker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayawata3626/team-approval-checker.git"
  },
  "bugs": {
    "url": "https://github.com/hayawata3626/team-approval-checker/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "package": "rolldown --config rolldown.config.mjs",
    "package:watch": "npm run package -- --watch",
    "test": "vitest run",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.7",
    "nock": "^14.0.11",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "prettier": "^3.7.4",
    "rolldown": "^1.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
