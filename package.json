{
  "name": "team-approval-checker",
  "description": "Team Approval Checker",
  "version": "1.2.2",
  "author": "hayawata3626",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/hayawata3626/team-approval-checker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayawata3626/team-approval-checker.git"
  },
  "bugs": {
    "url": "https://github.com/hayawata3626/team-approval-checker/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "format:write": "prettier --write **/*.ts",
    "format:check": "prettier --check **/*.ts",
    "lint": "npx eslint . -c ./.github/linters/.eslintrc.yml",
    "package": "rollup --config rollup.config.mjs",
    "package:watch": "npm run package -- --watch",
    "test": "(NODE_OPTIONS=--experimental-vm-modules jest && make-coverage-badge --output-path ./badges/coverage.svg) || make-coverage-badge --output-path ./badges/coverage.svg",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "prepare": "husky install"
  },
  "license": "MIT",
  "jest": {
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.7",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.57.0",
    "eslint-plugin-github": "^4.10.2",
    "eslint-plugin-jest": "^29.17.2",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "make-coverage-badge": "^1.2.0",
    "nock": "^14.0.11",
    "prettier": "^3.7.4",
    "prettier-eslint": "^16.4.2",
    "rollup": "^4.68.8",
    "rollup-plugin-license": "^3.7.2",
    "ts-jest": "^29.4.6",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3"
  }
}
